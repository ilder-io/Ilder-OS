# Belt-and-suspenders for the React 19 ecosystem transition: recharts>=2.15
# and the `react-is` override in package.json fix the specific conflict
# npm surfaces on a clean install, but smaller Radix/utility packages
# occasionally lag a patch release behind on declaring React 19 in their
# own peerDependencies even though they work fine at runtime. This avoids
# every contributor needing to remember `--legacy-peer-deps` by hand.
legacy-peer-deps=true
